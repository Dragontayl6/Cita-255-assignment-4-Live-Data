<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cita_255_assignment_4_Live_Data.MainPage">

    <VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="QuestLog" Style="{StaticResource Headline}" />

        <Entry Text="{Binding NewTitle, Mode=TwoWay}" Placeholder="Quest title" />
        <Entry Text="{Binding NewGiver, Mode=TwoWay}" Placeholder="Quest giver" />
        <Entry Text="{Binding NewReward, Mode=TwoWay}" Placeholder="Reward" Keyboard="Numeric" />

        <Button Text="Add quest" Clicked="OnAddQuestClicked" />
        <Label Text="{Binding Message}" TextColor="Red" />

        <CollectionView ItemsSource="{Binding Quests}"
                        SelectedItem="{Binding SelectedQuest, Mode=TwoWay}"
                        SelectionMode="Single"
                        HeightRequest="400">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="{Binding Title}" />
                        <Label Grid.Column="1" Text="{Binding Giver}" />
                        <Label Grid.Column="2" Text="{Binding Reward}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Remove selected quest" Clicked="OnRemoveQuestClicked" />
    </VerticalStackLayout>

</ContentPage>
